{
    "name": "littleblackman/api-appli-v",
    "type": "project",
    "description": "API for Projet V",
    "homepage": "https://appli-v.net",
    "license": "proprietary",
    "authors": [
        {
            "name": "Laurent Marquet",
            "email": "laurent.marquet@laposte.net",
            "homepage": "https://github.com/Laurent3170",
            "role": "Developer"
        }
    ],
    "repositories": [
        { "type": "path", "url": "patched/c975l/user-bundle" },
        { "type": "path", "url": "patched/c975l/email-bundle" },
        { "type": "path", "url": "patched/c975l/services-bundle" }
    ],
    "require": {
        "php": ">=7.4",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "c975l/user-bundle": "^2",
        "c975l/email-bundle": "^2",
        "doctrine/doctrine-bundle": "^2.4",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^2.7",
        "knplabs/knp-paginator-bundle": "^6",
        "lcobucci/jwt": "^3",
        "nelmio/api-doc-bundle": "^4",
        "nelmio/cors-bundle": "^2",
        "sensio/framework-extra-bundle": "^6",
        "symfony/apache-pack": "^1",
        "symfony/asset": "*",
        "symfony/cache": "^6.4",
        "symfony/console": "*",
        "symfony/dotenv": "^6.4",
        "symfony/expression-language": "*",
        "symfony/flex": "^1.21",
        "symfony/form": "*",
        "symfony/framework-bundle": "*",
        "symfony/monolog-bundle": "^3",
        "symfony/property-access": "*",
        "symfony/routing": "*",
        "symfony/security-bundle": "*",
        "symfony/mailer": "^6.4",
        "symfony/templating": "*",
        "symfony/translation": "*",
        "symfony/twig-bundle": "*",
        "symfony/validator": "*",
        "symfony/yaml": "*"
    },
    "require-dev": {
        "composer/package-versions-deprecated": "^1.11",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^8.5",
        "symfony/browser-kit": "6.4.*",
        "symfony/css-selector": "6.4.*",
        "symfony/debug-bundle": "6.4.*",
        "symfony/maker-bundle": "^1",
        "symfony/phpunit-bridge": "^7.3",
        "symfony/stopwatch": "6.4.*",
        "symfony/var-dumper": "*",
        "symfony/web-profiler-bundle": "6.4.*"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "composer/package-versions-deprecated": true,
            "ocramius/package-versions": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "config/annotations_bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    }
}
